{
  "name": "planlock-console",
  "version": "0.1.0",
  "private": true,
  "description": "Web console for planlock (plan-vs-trajectory drift) and ClaudeThrottle (per-turn token cost) — Vue 3 + TypeScript + Fastify",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "start": "tsx server/index.ts",
    "demo": "node scripts/demo-live.mjs",
    "fixtures": "node scripts/demo-live.mjs --out fixtures --name demo-warn --delay 0 --session sess-demo-fixture && node scripts/demo-live.mjs --out fixtures --name demo-strict --delay 0 --mode strict --session sess-strict-fixture",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "@fastify/static": "^8.0.3",
    "fastify": "^5.1.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.1.10"
  }
}
